# Copy to .env for local development.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway

# Separate database for the test suite. The setup auto-creates it on first
# `npm test` if it doesn't exist, so usually no manual step is required.
TEST_DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway_test

# Provider mode. Defaults to "true" so a fresh clone, every test run, and
# any "I just want to see the gateway move" demo never accidentally bills
# a real provider account. Set to "false" to switch to real adapters
# (per-provider; missing keys fall back to mock with a warning).
MOCK_PROVIDERS=true

# Provider keys. Required only when MOCK_PROVIDERS=false AND you want to
# exercise that specific upstream. Empty key = mock fallback for that
# provider only (the other provider is unaffected).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Phase 9/11 admin endpoints. Leave UNSET to keep /admin/* unmounted
# (404 to anyone). Set to a long random string in any environment where
# you want the read-only usage endpoint OR the Phase 11 eval-only
# helpers (failure-mode / reset-usage / set-budget) to be reachable.
ADMIN_TOKEN=

# Per-call upstream timeout, milliseconds. The resilience wrapper races
# every provider call against this and synthesizes a retryable 504 if
# the provider doesn't return in time. Default 20s matches the
# assignment spec; lower it (e.g. 5000) for chaos demos.
PROVIDER_TIMEOUT_MS=20000

# Response cache TTL, seconds. Applies to deterministic non-streaming
# requests only (temperature == 0, stream == false). Set to a smaller
# number for cache-expiry demos. Default 300 = 5 minutes.
CACHE_TTL_SECONDS=300
