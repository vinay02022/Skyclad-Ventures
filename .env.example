# Copy to .env for local development.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway

# Separate database for the test suite. The setup auto-creates it on first
# `npm test` if it doesn't exist, so usually no manual step is required.
TEST_DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway_test

# Provider mode. Defaults to "true" so a fresh clone, every test run, and
# any "I just want to see the gateway move" demo never accidentally bills
# a real provider account. Set to "false" to switch to real adapters
# (per-provider; missing keys fall back to mock with a warning).
MOCK_PROVIDERS=true

# Provider keys. Required only when MOCK_PROVIDERS=false AND you want to
# exercise that specific upstream. Empty key = mock fallback for that
# provider only (the other provider is unaffected).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Phase 9 admin endpoints. Leave UNSET to keep /admin/* unmounted (404 to
# anyone). Set to a long random string in any environment where you want
# GET /admin/tenants/:tenantId/usage to be reachable.
ADMIN_TOKEN=
